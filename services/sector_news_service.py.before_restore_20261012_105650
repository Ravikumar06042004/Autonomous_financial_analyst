def _domain(url: str) -> str:
    try:
        return (
            urlparse(url)
            .netloc
            .lower()
            .removeprefix("www.")
        )

    except Exception:
        return ""


def _published_date(value):
    """The topic-news layer already returns ISO dates.

    This parser also supports Unix timestamps as a defensive
    fallback.
    """

    if not value:
        return None

    if isinstance(
        value,
        (int, float),
    ):
        try:
            timestamp = float(value)

            if timestamp > 10_000_000_000:
                timestamp /= 1000.0

            return datetime.fromtimestamp(
                timestamp,
                tz=timezone.utc,
            )

        except (
            TypeError,
            ValueError,
            OverflowError,
            OSError,
        ):
            return None

    text = str(value).strip()

    try:
        dt = datetime.fromisoformat(
            text.replace(
                "Z",
                "+00:00",
            )
        )

        return (
            dt
            if dt.tzinfo
            else dt.replace(
                tzinfo=timezone.utc
            )
        )

    except ValueError:
        return None


def _is_recent_24h(
    value,
    reference: datetime | None = None,
) -> bool:
    """Defensive final 24-hour gate."""

    published = _published_date(value)

    if published is None:
        return False

    reference = reference or datetime.now(
        timezone.utc
    )

    age_hours = (
        reference - published
    ).total_seconds() / 3600.0

    if age_hours < 0:
        return False

    return age_hours <= 24.0


def _event_for_article(text: str):
    lower = text.lower()

    for event_type, patterns in EVENT_PATTERNS:
        for pattern in patterns:
            match = re.search(
                pattern,
                lower,
            )

            if match:
                evidence = text[
                    max(
                        0,
                        match.start(),
                    ):
                    min(
                        len(text),
                        match.end() + 50,
                    )
                ].strip()

                return (
                    event_type,
                    evidence,
                )

    return (
        "OTHER",
        "",
    )


def _keyword_sentiment(
    text: str,
) -> float:

    words = re.findall(
        r"[a-z][a-z-]+",
        text.lower(),
    )

    positive = sum(
        1
        for word in words
        if word in POSITIVE_WORDS
    )

    negative = sum(
        1
        for word in words
        if word in NEGATIVE_WORDS
    )

    if positive == negative == 0:
        return 0.0

    return max(
        -1.0,
        min(
            1.0,
            (
                positive - negative
            )
            / max(
                3,
                positive + negative,
            ),
        ),
    )


def _sector_matches(
    text: str,
) -> list[str]:

    lower = text.lower()

    matches: list[str] = []

    for sector, terms in SECTOR_TERMS.items():
        if any(
            term in lower
            for term in terms
        ):
            matches.append(sector)

    return matches


