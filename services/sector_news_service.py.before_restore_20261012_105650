class _GlobalArticleParser(HTMLParser):
    """Extract article metadata and same-domain links from an HTML page."""

    _DATE_KEYS = {
        "article:published_time",
        "datepublished",
        "datepublishedoriginal",
        "publishdate",
        "pubdate",
        "date",
        "dc.date",
        "dc.date.issued",
        "datecreated",
        "article:modified_time",
    }

    def __init__(self):
        super().__init__(convert_charrefs=True)
        self.dates = []
        self.links = []
        self.jsonld = []
        self.title_parts = []
        self.description = ""
        self.canonical_url = ""
        self._in_title = False
        self._in_jsonld = False
        self._script_parts = []

    def handle_starttag(self, tag, attrs):
        attrs = dict(attrs)

        if tag == "meta":
            key = (
                attrs.get("property")
                or attrs.get("name")
                or attrs.get("itemprop")
                or ""
            ).strip().lower()
            content = (
                attrs.get("content")
                or attrs.get("datetime")
                or ""
            ).strip()

            if key in self._DATE_KEYS and content:
                self.dates.append(content)

            if key in {"og:title", "twitter:title"} and content:
                self.title_parts.append(content)

            if (
                key in {"og:description", "description", "twitter:description"}
                and content
                and not self.description
            ):
                self.description = content

        elif tag == "time":
            value = (
                attrs.get("datetime")
                or attrs.get("content")
                or ""
            ).strip()
            if value:
                self.dates.append(value)

        elif tag == "link":
            rel = (attrs.get("rel") or "").lower().split()
            if "canonical" in rel:
                self.canonical_url = (attrs.get("href") or "").strip()

            key = (
                attrs.get("itemprop")
                or attrs.get("property")
                or ""
            ).strip().lower()
            value = (
                attrs.get("content")
                or attrs.get("href")
                or ""
            ).strip()
            if key in self._DATE_KEYS and value:
                self.dates.append(value)

        elif tag == "a":
            href = (attrs.get("href") or "").strip()
            if href:
                self.links.append(href)

        elif tag == "title":
            self._in_title = True

        elif tag == "script":
            script_type = (attrs.get("type") or "").lower()
            if "ld+json" in script_type:
                self._in_jsonld = True
                self._script_parts = []

    def handle_data(self, data):
        if self._in_title and data.strip():
            self.title_parts.append(data.strip())
        if self._in_jsonld:
            self._script_parts.append(data)

    def handle_endtag(self, tag):
        if tag == "title":
            self._in_title = False
        elif tag == "script" and self._in_jsonld:
            payload = "".join(self._script_parts).strip()
            if payload:
                try:
                    self.jsonld.append(json.loads(payload))
                except (ValueError, TypeError):
                    pass
            self._in_jsonld = False
            self._script_parts = []


def _global_parse_datetime(value):
    """Parse ISO, Unix, RFC-style, and common relative publication dates."""
    if value is None or value == "":
        return None

    parsed = _published_date(value)
    if parsed is not None:
        return parsed.astimezone(timezone.utc)

    text = str(value).strip()
    if not text:
        return None

    try:
        parsed = parsedate_to_datetime(text)
        if parsed is not None:
            if parsed.tzinfo is None:
                parsed = parsed.replace(tzinfo=timezone.utc)
            return parsed.astimezone(timezone.utc)
    except (TypeError, ValueError, OverflowError):
        pass

    now = datetime.now(timezone.utc)
    lower = text.lower()
    if lower in {"just now", "now"}:
        return now
    if lower == "yesterday":
        return now - timedelta(days=1)

    match = re.search(
        r"(\d+)\s+(minute|min|hour|hr|day|week)s?\s+ago",
        lower,
    )
    if match:
        amount = int(match.group(1))
        unit = match.group(2)
        if unit in {"minute", "min"}:
            return now - timedelta(minutes=amount)
        if unit in {"hour", "hr"}:
            return now - timedelta(hours=amount)
        if unit == "day":
            return now - timedelta(days=amount)
        if unit == "week":
            return now - timedelta(weeks=amount)

    for fmt in (
        "%b %d, %Y %I:%M %p",
        "%B %d, %Y %I:%M %p",
        "%b %d, %Y",
        "%B %d, %Y",
        "%Y-%m-%d %H:%M:%S",
        "%Y-%m-%d",
    ):
        try:
            return datetime.strptime(text, fmt).replace(tzinfo=timezone.utc)
        except ValueError:
            continue

    return None


def _global_jsonld_dates(value):
    dates = []
    if isinstance(value, dict):
        for key, item in value.items():
            if key.lower() in {"datepublished", "datecreated", "uploaddate"} and item:
                dates.append(item)
            dates.extend(_global_jsonld_dates(item))
    elif isinstance(value, list):
        for item in value:
            dates.extend(_global_jsonld_dates(item))
    return dates


def _global_host_allowed(url, allowed_domains):
    try:
        host = (urlparse(str(url)).hostname or "").lower().rstrip(".")
    except (TypeError, ValueError):
        return False
    if not host:
        return False
    return any(
        host == domain or host.endswith("." + domain)
        for domain in allowed_domains
    )


def _global_listing_page(url):
    """Identify known channel/landing pages, not publishable articles."""
    try:
        parsed = urlparse(url)
        path = parsed.path.lower().rstrip("/")
    except (TypeError, ValueError):
        return True

    known_source_pages = {
        urlparse(item.get("url", "")).path.lower().rstrip("/")
        for item in GLOBAL_CHANNEL_SOURCE_PAGES.values()
    }
    return (
        path in known_source_pages
        or "/news/tags/" in path
        or path.endswith("/markets")
        or path.endswith("/news")
    )


def _fetch_global_html(url, allowed_domains):
    """Fetch a public page with a short timeout; return parsed metadata."""
    if not _global_host_allowed(url, allowed_domains):
        return None

    request = Request(
        url,
        headers={
            "User-Agent": (
                "Mozilla/5.0 (Windows NT 10.0; Win64; x64) "
                "AppleWebKit/537.36 (KHTML, like Gecko) "
                "Chrome/125.0 Safari/537.36"
            ),
            "Accept": "text/html,application/xhtml+xml,*/*;q=0.8",
        },
    )

    try:
        with urlopen(request, timeout=GLOBAL_PAGE_TIMEOUT_SECONDS) as response:
            final_url = response.geturl()
            if not _global_host_allowed(final_url, allowed_domains):
                return None
            raw = response.read(1_000_000)
            html = raw.decode("utf-8", errors="replace")
    except (HTTPError, URLError, TimeoutError, OSError, ValueError):
        return None
    except Exception:
        return None

    parser = _GlobalArticleParser()
    try:
        parser.feed(html)
        parser.close()
    except Exception:
        pass

    date_candidates = list(parser.dates)
    for item in parser.jsonld:
        date_candidates.extend(_global_jsonld_dates(item))

    published = None
    for candidate in date_candidates:
        published = _global_parse_datetime(candidate)
        if published is not None:
            break

    canonical_url = (
        urljoin(final_url, parser.canonical_url)
        if parser.canonical_url
        else final_url
    )
    if not _global_host_allowed(canonical_url, allowed_domains):
        canonical_url = final_url

    links = []
    for href in parser.links:
        link = urljoin(final_url, href)
        if not link.startswith("https://"):
            continue
        if not _global_host_allowed(link, allowed_domains):
            continue
        if link not in links:
            links.append(link)

    return {
        "url": canonical_url,
        "title": " ".join(parser.title_parts).strip(),
        "content": parser.description.strip(),
        "published_at": published,
        "links": links,
    }


def _global_serper_candidates(query, allowed_domains):
    """Search trusted domains individually and validate every result locally."""
    domains = list(dict.fromkeys(
        str(domain).strip().lower()
        for domain in allowed_domains
        if str(domain).strip()
    ))

    if not domains:
        return []

    client = SerperClient()
    results = []
    seen = set()
    now = datetime.now(timezone.utc)
    after_date = (now - timedelta(hours=48)).date().isoformat()
    fresh_count = 0

    # A separate site query avoids unreliable multi-domain OR expressions.
    # Primary Moneycontrol search performs one request; fallback searches
    # up to five trusted publishers to control API usage.
    domains_to_search = domains[:5] if len(domains) > 1 else domains

    for domain in domains_to_search:
        search_query = f"site:{domain} {query} after:{after_date}"

        try:
            rows = client.search_news(
                query=search_query,
                num=5,
            )
        except Exception:
            continue

        for row in rows or []:
            if not isinstance(row, dict):
                continue

            url = str(row.get("link") or row.get("url") or "").strip()
            if not url.startswith("https://"):
                continue
            if not _global_host_allowed(url, domains):
                continue

            key = url.rstrip("/").lower()
            if key in seen:
                continue
            seen.add(key)

            raw_date = (
                row.get("date")
                or row.get("publishedDate")
                or row.get("published_date")
            )
            published = _global_parse_datetime(raw_date)

            results.append({
                "url": url,
                "title": str(row.get("title") or "").strip(),
                "source": str(row.get("source") or _domain(url)),
                "content": str(
                    row.get("snippet") or row.get("content") or ""
                ).strip(),
                "published_at": published,
            })

            # Use this only to decide whether more publishers should be
            # queried. Final eligibility is checked again downstream.
            if published is not None:
                age_hours = (
                    now - published
                ).total_seconds() / 3600.0
                if 0 <= age_hours <= 24:
                    fresh_count += 1

        if fresh_count >= 4:
            break

    if not results and domains == ["moneycontrol.com"]:
        results.append({
            "url": (
                "https://www.moneycontrol.com/news/tags/"
                "global-indices.html"
            ),
            "title": "Moneycontrol ? Global Indices News",
            "source": "moneycontrol.com",
            "content": "",
            "published_at": None,
        })

    return results

def _process_global_candidates(name, candidates, allowed_domains, max_results):
    """Enrich candidate dates from pages and discover article links from listings."""
    found = []
    seen = set()

    # Use each configured channel's listing page as a primary fallback.
    source_info = GLOBAL_CHANNEL_SOURCE_PAGES.get(name, {})
    primary_listing_url = str(source_info.get("url") or "").strip()

    effective_domains = list(allowed_domains)
    primary_domain = (
        _domain(primary_listing_url) if primary_listing_url else ""
    )
    if primary_domain and primary_domain not in effective_domains:
        effective_domains.append(primary_domain)
    allowed_domains = effective_domains

    queue = list(candidates)
    if primary_listing_url and not any(
        str(item.get("url", "")).rstrip("/").lower()
        == primary_listing_url.rstrip("/").lower()
        for item in queue
    ):
        queue.insert(0, {
            "url": primary_listing_url,
            "title": source_info.get("name", name),
            "source": primary_domain,
            "content": "",
            "published_at": None,
        })

    def _candidate_priority(candidate):
        url = str(candidate.get("url", "")).lower()

        non_article_paths = (
            "/video/",
            "/quotes/",
            "/watch/",
            "youtube.com",
            "/stocks/marketstats/",
            "/indian-indices/",
            "/india/stockpricequote/",
        )
        is_non_article = any(
            item in url for item in non_article_paths
        )

        published = _global_parse_datetime(
            candidate.get("published_at")
        )
        published_rank = (
            published.timestamp() if published is not None else 0
        )

        import re

        date_keys = []

        for year, month, day in re.findall(
            r"(?<!\d)(20\d{2})[-/](\d{1,2})[-/](\d{1,2})(?!\d)",
            url,
        ):
            if 1 <= int(month) <= 12 and 1 <= int(day) <= 31:
                date_keys.append(
                    year + month.zfill(2) + day.zfill(2)
                )

        # Moneycontrol URL slugs commonly use DD-MM-YYYY.
        for day, month, year in re.findall(
            r"(?<!\d)(\d{1,2})[-/](\d{1,2})[-/](20\d{2})(?!\d)",
            url,
        ):
            if 1 <= int(month) <= 12 and 1 <= int(day) <= 31:
                date_keys.append(
                    year + month.zfill(2) + day.zfill(2)
                )

        date_key = max(date_keys, default="00000000")

        has_news_path = any(
            item in url
            for item in ("/news/", "/markets/", "/global-indices/")
        )

        if (
            primary_listing_url
            and url.rstrip("/").lower()
            == primary_listing_url.rstrip("/").lower()
        ):
            return (3, published_rank, 1, date_key)

        source_rank = (
            2 if candidate.get("_from_listing")
            else (0 if is_non_article else 1)
        )
        return (
            source_rank,
            published_rank,
            1 if has_news_path else 0,
            date_key,
        )

    queue.sort(key=_candidate_priority, reverse=True)

    fetch_count = 0
    now = datetime.now(timezone.utc)

    while queue and len(found) < max_results and fetch_count < GLOBAL_MAX_PAGE_FETCHES:
        queue.sort(key=_candidate_priority, reverse=True)
        candidate = queue.pop(0)
        url = candidate.get("url", "")
        if not _global_host_allowed(url, allowed_domains) or url in seen:
            continue
        seen.add(url)

        listing = _global_listing_page(url)

        non_article_paths = (
            "/video/",
            "/quotes/",
            "/watch/",
            "youtube.com",
            "/stocks/marketstats/",
            "/indian-indices/",
            "/india/stockpricequote/",
        )

        if not listing and any(
            item in url.lower() for item in non_article_paths
        ):
            continue

        published = candidate.get("published_at")
        page = None

        if listing or published is None:
            fetch_count += 1
            page = _fetch_global_html(url, allowed_domains)

        if listing:
            # A source/tag page itself is never counted as a news article.
            if page:
                for link in page["links"]:
                    link = str(link).strip().split("#", 1)[0]
                    lowered = link.lower()

                    # Keep actual news articles, not navigation or quote pages.
                    if (
                        not _global_host_allowed(link, allowed_domains)
                        or _global_listing_page(link)
                        or link in seen
                    ):
                        continue

                    if "/news/" not in lowered or ".html" not in lowered:
                        continue

                    if any(part in lowered for part in (
                        "/news/tags/",
                        "/news/videos/",
                        "/video/",
                        "/quotes/",
                        "/watch/",
                        "youtube.com",
                        "/stocks/marketstats/",
                        "/indian-indices/",
                        "/india/stockpricequote/",
                    )):
                        continue

                    if any(item.get("url") == link for item in queue):
                        continue

                    queue.append({
                        "url": link,
                        "title": "",
                        "source": _domain(link),
                        "content": "",
                        "published_at": None,
                        "_from_listing": True,
                    })
            continue

        title = candidate.get("title") or (page or {}).get("title", "")
        content = candidate.get("content") or (page or {}).get("content", "")
        article_url = (page or {}).get("url") or url
        published = published or (page or {}).get("published_at")

        if not title or published is None:
            continue
        age_hours = (now - published).total_seconds() / 3600.0
        if age_hours < 0 or age_hours > 24:
            continue

        found.append({
            "title": title,
            "url": article_url,
            "source": candidate.get("source") or _domain(article_url),
            "content": content,
            "snippet": content,
            "published_at": published.isoformat(),
            "published_date": published.isoformat(),
        })

    return found[:max_results], fetch_count


def _search_global_channel_news(name, query, max_results):
    """Moneycontrol-first global-news search with strict, dated results."""
    diagnostics = []

    def _relevant_global_articles(rows):
        if name not in GLOBAL_MARKET_KEYS:
            return rows

        if name == "GLOBAL_INDICES":
            terms = (
                "global market", "global markets", "global indices",
                "global stocks", "global stock market", "world market",
                "world markets", "world stocks", "international markets",
                "wall street", "u.s. market", "us market", "u.s. stocks",
                "us stocks", "asian markets", "asian stocks",
                "european markets", "european stocks", "nikkei",
                "hang seng", "kospi", "s&p 500", "dow jones", "nasdaq",
                "ftse", "dax", "cac 40", "shanghai composite",
                "china stocks", "japan stocks", "dollar index", "dxy",
                "treasury yields", "bond yields", "federal reserve",
                "global selloff", "global rally", "global economy",
                "emerging markets", "equity indices", "equity markets",
                "market lags europe", "european shares", "asia shares",
                "u.s. shares", "us shares",
            )
        else:
            terms = (
                "global market", "global markets", "global indices",
                "global stocks", "global equity", "world market trends",
                "world markets", "world stocks", "international markets",
                "wall street", "u.s. market", "us market", "u.s. stocks",
                "us stocks", "asian markets", "asian stocks",
                "european markets", "european stocks", "nikkei",
                "hang seng", "kospi", "s&p 500", "dow jones", "nasdaq",
                "ftse", "dax", "global economy", "global trade",
                "market lags europe", "european shares", "asia shares",
                "world economy", "international equities",
            )

        valid = []
        for row in rows:
            headline = " ".join(
                str(row.get("title") or "").casefold().split()
            )
            if any(term in headline for term in terms):
                valid.append(row)
        return valid

    # 1) Moneycontrol search results plus the channel's public listing page.
    primary_domains = ["moneycontrol.com"]
    try:
        candidates = _global_serper_candidates(
            query=f"{query} latest news",
            allowed_domains=primary_domains,
        )
    except Exception as exc:
        candidates = []
        diagnostics.append(
            f"Moneycontrol search error: {type(exc).__name__}: {str(exc)[:120]}"
        )

    source_page = GLOBAL_CHANNEL_SOURCE_PAGES.get(name, {}).get("url")
    if source_page and not any(item.get("url") == source_page for item in candidates):
        candidates.insert(0, {
            "url": source_page,
            "title": "",
            "source": "moneycontrol.com",
            "content": "",
            "published_at": None,
        })

    primary, fetched = _process_global_candidates(
        name,
        candidates,
        primary_domains,
        max_results,
    )
    primary = _relevant_global_articles(primary)
    diagnostics.append(
        f"Moneycontrol candidates fetched: {fetched}; fresh articles: {len(primary)}"
    )
    # Always search trusted publishers too; merge results below.
    try:
        fallback_candidates = _global_serper_candidates(
            query=f"{query} global world stock markets latest financial news",
            allowed_domains=GLOBAL_FALLBACK_DOMAINS,
        )
    except Exception as exc:
        fallback_candidates = []
        diagnostics.append(
            f"Trusted-source search error: {type(exc).__name__}: {str(exc)[:120]}"
        )

    fallback, fetched = _process_global_candidates(
        name,
        fallback_candidates,
        GLOBAL_FALLBACK_DOMAINS,
        max_results,
    )
    fallback = _relevant_global_articles(fallback)
    diagnostics.append(
        f"Trusted-source candidates fetched: {fetched}; fresh articles: {len(fallback)}"
    )

    # Prefer a mixture of Moneycontrol and trusted-publisher evidence.
    combined = []
    seen_urls = set()

    def _add_unique(rows, limit):
        for article in rows:
            url = str(article.get("url") or "").strip()
            key = url.split("?", 1)[0].rstrip("/").lower()
            if key.endswith("/amp"):
                key = key[:-4].rstrip("/")
            if not key or key in seen_urls:
                continue
            seen_urls.add(key)
            combined.append(article)
            if len(combined) >= limit:
                return

    limit = max(1, int(max_results))

    if primary and fallback and limit > 1:
        # Reserve roughly half the result slots for other publishers.
        primary_target = max(1, limit // 2)
        _add_unique(primary, primary_target)
        _add_unique(fallback, limit)
        _add_unique(primary, limit)
    else:
        _add_unique(primary + fallback, limit)

    if primary and fallback:
        method = "Moneycontrol + trusted-source fallback"
    elif primary:
        method = "Moneycontrol"
    elif fallback:
        method = "trusted-source fallback"
    else:
        method = "no fresh articles"

    return combined[:limit], method, diagnostics


def _search_channel_news(name, query, max_results):
    """Use the existing fresh-news search for sectors and strict retrieval for global channels."""
    if name in GLOBAL_MARKET_KEYS:
        return _search_global_channel_news(name, query, max_results)

    rows = search_topic_news(
        query=query,
        max_results=max_results,
        time_range="day",
    )
    return rows, "standard search", []


