def _normalize_item(
    item: dict,
    forced_sector: str | None = None,
) -> dict:

    title = str(
        item.get("title")
        or ""
    ).strip()

    url = str(
        item.get("url")
        or ""
    ).strip()

    content = str(
        item.get("content")
        or item.get("snippet")
        or ""
    ).strip()

    combined = (
        f"{title}. {content}"
    )

    matches = _sector_matches(
        combined
    )

    if (
        forced_sector
        and forced_sector in SECTOR_TERMS
        and forced_sector not in matches
    ):
        matches.append(
            forced_sector
        )

    event_type, evidence = (
        _event_for_article(
            combined
        )
    )

    direction = (
        EVENT_BROAD_DIRECTION.get(
            event_type,
            _keyword_sentiment(
                combined
            ),
        )
    )

    published = _published_date(
        item.get("published_at")
        or item.get("published_date")
    )

    source = str(
        item.get("source")
        or _domain(url)
    ).lower().removeprefix(
        "www."
    )

    relevance = min(
        1.0,
        0.45
        + 0.10 * len(matches)
        + (
            0.20
            if event_type != "OTHER"
            else 0.0
        ),
    )

    confidence = min(
        0.90,
        0.55
        + (
            0.15
            if event_type != "OTHER"
            else 0.0
        )
        + (
            0.05
            if content
            else 0.0
        ),
    )

    return {
        "title": title,
        "url": url,
        "source": source,
        "source_reference_name": GLOBAL_CHANNEL_SOURCE_PAGES.get(
            forced_sector, {}
        ).get("name", ""),
        "source_reference_url": GLOBAL_CHANNEL_SOURCE_PAGES.get(
            forced_sector, {}
        ).get("url", ""),

        "published_at": (
            published.isoformat()
            if published
            else None
        ),

        "published_date": (
            published.isoformat()
            if published
            else None
        ),

        "content": content[:4000],

        "sectors": matches,

        "event_type": event_type,

        "event_key": url.lower(),

        "evidence": (
            evidence
            or title[:300]
        ),

        "relevance": round(
            relevance,
            3,
        ),

        "confidence": round(
            confidence,
            3,
        ),

        "magnitude": round(
            min(
                1.0,
                0.5
                + 0.1 * len(matches),
            ),
            3,
        ),

        "india_direction": round(
            direction,
            3,
        ),

        "reliability": SOURCE_RELIABILITY.get(
            source,
            0.70,
        ),
    }


