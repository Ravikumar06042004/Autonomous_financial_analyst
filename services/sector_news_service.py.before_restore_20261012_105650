def search_sector_news(
    sector_key: str,
    max_results: int = 5,
) -> list[dict]:
    """Backward-compatible single-sector search.

    Only last 24 hours is allowed.
    """

    query = SECTOR_QUERIES.get(
        sector_key,
        f"{sector_key} India latest financial news",
    )

    try:
        raw, search_mode, search_details = _search_channel_news(
            sector_key,
            query,
            max_results,
        )
        for detail in search_details:
            print(f"[{sector_key}] {detail}")

    except Exception as exc:
        print(
            f"Sector news unavailable for "
            f"{sector_key}: "
            f"{type(exc).__name__}: {exc}"
        )

        return []

    reference = datetime.now(
        timezone.utc
    )

    results: list[dict] = []

    for item in raw:

        published = (
            item.get("published_at")
            or item.get("published_date")
        )

        if not _is_recent_24h(
            published,
            reference,
        ):
            continue

        normalized = _normalize_item(
            item,
            forced_sector=sector_key,
        )

        if (
            normalized["url"]
            and normalized["title"]
            and normalized.get("published_at")
        ):
            results.append(
                normalized
            )

        if len(results) >= max_results:
            break

    return results


# ============================================================
# SHARED COLLECTION: MARKET + 22 NEWS CHANNELS
# ============================================================

def collect_sector_news(
    max_results_per_query: int = 4,
):
    """Collect one shared recent-news pool for the 20 industry sectors plus 2 global-market channels.

    Every MARKET / sector query asks Serper for live results.

    Only articles published within the previous 24 hours
    are allowed into the shared pool.
    """

    diagnostics: list[str] = []

    raw_items: list[
        tuple[str, dict]
    ] = []

    all_queries = {
        "MARKET": MACRO_QUERY,
        **SECTOR_QUERIES,
    }

    reference = datetime.now(
        timezone.utc
    )

    # --------------------------------------------------------
    # One live Serper query per market/sector topic
    # --------------------------------------------------------
    for name, query in all_queries.items():
        try:
            raw, search_mode, search_details = _search_channel_news(
                name,
                query,
                max_results_per_query,
            )

            for detail in search_details:
                diagnostics.append(f"News query {name}: {detail}")

            diagnostics.append(
                f"News query {name}: {len(raw)} recent result(s) "
                f"from last 24h; method={search_mode}"
            )

            for item in raw:
                raw_items.append((name, item))

        except Exception as exc:
            diagnostics.append(
                f"News query {name}: ERROR "
                f"{type(exc).__name__}: {str(exc)[:160]}"
            )

    # --------------------------------------------------------
    # Normalize + defensive final freshness check
    # --------------------------------------------------------
    seen: set[str] = set()

    articles: list[dict] = []

    for query_name, item in raw_items:

        published = (
            item.get("published_at")
            or item.get("published_date")
        )

        if not _is_recent_24h(
            published,
            reference,
        ):
            continue

        normalized = _normalize_item(
            item,
            (
                None
                if query_name == "MARKET"
                else query_name
            ),
        )

        # Preserve explicit ownership by each of the two new channels.
        if query_name in GLOBAL_MARKET_KEYS:
            existing_sectors = normalized.get("sectors") or []
            if isinstance(existing_sectors, str):
                existing_sectors = [existing_sectors]
            else:
                existing_sectors = list(existing_sectors)

            existing_upper = {
                str(value).upper() for value in existing_sectors
            }
            if query_name not in existing_upper:
                existing_sectors.append(query_name)
            normalized["sectors"] = existing_sectors

        if (
            not normalized["url"]
            or not normalized["title"]
            or not normalized.get(
                "published_at"
            )
        ):
            continue

        key = normalized[
            "url"
        ]

        if key in seen:
            if query_name in GLOBAL_MARKET_KEYS:
                existing_article = next(
                    (article for article in articles
                     if article.get("url") == key),
                    None,
                )
                if existing_article is not None:
                    sectors = existing_article.get("sectors") or []
                    if isinstance(sectors, str):
                        sectors = [sectors]
                    else:
                        sectors = list(sectors)
                    if query_name not in {
                        str(value).upper() for value in sectors
                    }:
                        sectors.append(query_name)
                    existing_article["sectors"] = sectors
            continue

        seen.add(key)

        articles.append(
            normalized
        )

    # --------------------------------------------------------
    # Final diagnostics
    # --------------------------------------------------------
    diagnostics.append(
        f"News articles collected: "
        f"{len(articles)} unique recent articles"
    )

    diagnostics.append(
        f"News sources used: "
        f"{len({a['source'] for a in articles if a.get('source')})}"
    )

    return (
        articles,
        diagnostics,
    )


